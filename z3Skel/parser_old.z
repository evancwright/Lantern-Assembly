;Crawls through the Lantern verb table, mapping dictionary ids to lantern verbs
;looks in the parse buffer
;if the 1st word isn't found -> error msg and return
;get the flags for the 1st word
;and it with VERB_MASK
;if the 1st word isn't a verb -> error msg and return
;if the word count is 1, set the prep id to 0
;if the word is 2 or more:
;get the flags for the 2nd word  
;and it with the PREP_MASK
;if zero skip, else put word id into prep
;table format [verb][prep or 0]->[lantern verb]




;set all scores to 0
routine clear_scores()
byte 2
word 0,0
.loop
	put_prop l01 OBJ_SCORE #00 ; set object l01 score to 0
	inc l01
	je l01 NUM_OBJECTS [FALSE] .loop ;jump back if not done
	ret

;for now ;l01 is the object, l02 is the word, l03 is loop counter, l04 is a temp
;words addrs are in properties 25,24,23,22,21,20 decimal
;score is property 19 decimal 
routine update_object_score(object, word)
byte 04
word 00,00,19,00
	;loop through each word property (25,24,23,22,21,20)
	;has the object already been marked as INVALID?
	get_prop l01 OBJ_SCORE -> l04 ;get the property or default value
	je l04 INVALID .no
	store l03 19 ; property 25
.loop
	get_prop l01 l03 -> l04 ;get the property or default value
	je l04 ffff .c  ; word did not exist on object (we got default value)
	;compare the address in L04 to the address in L01
	loadw l04,#01->(sp)
	je l01,(sp) [false] .c  ; compare first word (first 3 letters)
	loadw l04,#02->(sp)
	je l01,(sp) [false] .c  ; compare second word (second 3 letters)
	; we have a match! 
	get_prop l01 OBJ_SCORE -> L02
	inc l02  ; increment the score
	put_prop l01 OBJ_SCORE l02 
	rtrue 
.c	dec l03	; prop number--
	je  l03 #13 [false] .loop ;loop until we hit 19h
	;we never found a match, set score to INVALID
.no	put_prop l01 OBJ_SCORE FF
	rfalse  	 

;L01 temp
;L02 will be the prep id
;L03 will be the table address (base pointer)
;L04 will be the index into the table
;L05 

;l01 is loop counter
;l02 is max so far
routine get_max_score()
	.db 1
	.dw 1,255
.loop
	get_prop l01 13 -> (sp) ; get score of l01
	;is l02 ff? if so set score to current object's score
	je l01 NUM_OBJECTS [FALSE] .loop ;jump back if not done

	ret




routine get_verb_id
.db 03
.dw 0,0,0
	load L03 .parse_buff ; load the table [# words 0-255][ addr hi | addr lo | #letters | index  ]
	load L04 #01 ;offset of 1st word
	loadw [l03][L04] -> [L01] ; put dict addr into L01
	loadb L01 #05 -> L01
	and L01 VERB_MASK -> L01
	jz L01 .verb_not_found
	;is the word count 2 or greater
	
.c		
	
	
.verb_not_found
	print_paddr .bad_verb_str	
	ret 0
	
;l01 contains word address
;l02 is a loop counter
;l03 will be a local (table size)
routine is_prep()
byte 3
word 0,0,0
	load l02 #0
	loadw .prep_table l02 -> (l03) ; get table size
	inc l02
.loop 	
	load .prep_table l01 -> (l02)
	je  l01 l02 .yes
	inc l02
	jle l02 l03 .loop
	ret_false
.yes ret_true


routine execute_exact():
byte 3
word 0,0,0,0
	load #0 
.loop
	loadb .sentence_table l01 -> l02 ;verb
	inc l01
 	loadb .sentence_table l01 -> l03 ;noun1
	inc l01
 	loadb .sentence_table l01 -> l03 ;prep
	inc l01
 	loadb .sentence_table l01 -> l03 ;noun2
	inc l01 ; skip noun2
	add l01 #2 ; skip address
	;skip if we don't have a complete match
	je l02 G00 [false] .loop
	je l03 G01 [false] .loop
	je l04 G02 [false] .loop
	je l05 G03 [false] .loop
	;load the routine address
	sub l01 #2 ; back up to the address  
	loadw .sentence_table l01  ;load the function address
	storew .sneaky #02	l01 ;write the address to sneaky + 1
.sneaky	
	;set the handled variable
	call dummy
	ret

;if noun1 or noun2 of the sentence are not FF,
;and the entry in the table is 254 (the symbol for *)
;call the routine
routine execute_wildcard():
byte 3
word 0,0,0,0
	load #0 
.loop
	loadb .sentence_table l01 -> l02 ;verb
	inc l01
 	loadb .sentence_table l01 -> l03 ;noun1
	inc l01
 	loadb .sentence_table l01 -> l03 ;prep
	inc l01
 	loadb .sentence_table l01 -> l03 ;noun2
	inc l01 ; skip noun2
	add l01 #2 ; skip address
	;skip if we don't have a complete match
	je l02 G00 [false] .loop ; verbs don't match
	je l04 G02 [false] .loop ; preps don't match
	;;;;;;;;SPACE OUT HERE;;;;;
	;noun1 is 254 and g01 is not 255
	je l02 #fe [false] .c
	;noun1 is a wildcard in table
	je g01 #ff [false] .c
	;noun2 is 254 and g01 is not 255
	je l03 #fe [false] .c
	;noun2 is a wildcard in table
	je g04 #ff [false] .c
	;I think I am missing a case here?
.c	
	;load the routine address
	sub l01 #2 ; back up to the address  
	loadw .sentence_table l01  ;load the function address
	storew .sneaky2 #02	l01 ;write the address to sneaky + 1
.sneaky2	
	;set the handled variable
	call dummy
	ret
 