;look.asm


routine look_sub
byte 4
word 0,0,0,0
		; can the player see?
		call player_has_light->(sp)
		jz (sp) [false] .yes
		store l01 @pitchdark
		print_paddr l01
		new_line
		jump .x
.yes	;print room description
		store l01 PLAYER_ID
		get_parent l01 -> l01
		get_prop l01 DESCRIPTION -> (sp)
		print_paddr (sp)
		new_line

		;initial description on room?
;		get_prop L01 INITIAL_DESCRIPTION ->(sp)		; get initial desc for room
;		je (sp) ff .look ; intial description ; jump if no initial desc
;		put_prop L01 INITIAL_DESCRIPTION 00
;		jump .items

		store l01 PLAYER_ID
		get_parent l01 -> l01
		get_child l01 -> l01 [false] .x
.loop
		je l01 PLAYER_ID .c
		test_attr l01 SCENERY .c
		call list_object l01 -> l02	; prints "There is a ..." then the object
.c		get_sibling l01 -> l01 .loop
.x		rfalse

 
;called by look_sub		
;prints the initial description for object in b
;if it has one. Otherwise it defaults to "THERE IS A ____ HERE"
;the contents of the object are also printed.

;param 1 is the object
;param 2 is the indent level
routine list_object
byte 4
word 0,0,0,0	 
	;is it scenery
	test_attr l00 SCENERY [true] .x
	get_prop l00 INITIAL_DESCRIPTION ->l03 
;	print_num l03
;	new_line
	je l03 00 .no	
	print_paddr l03
	new_line
	jump .c
.no
	store l03 @thereisa
	print_paddr l03
	print_obj l00
	store l03 @here
	print_paddr l03
	new_line
.c	get_child l01 -> l01 [false] .x
	call list_siblings l01 -> l01
.x	rtrue
		
;player has light	
;player has light result in 'a'
;sets can_see

;This could probably be optimized
routine player_has_light
byte 3
word 0,0,0
		;is the room emitting light?
		get_parent PLAYER -> (sp) 
		test_attr (sp) LIT [true] .yes
		
		;is the player emitting light?
		test_attr PLAYER LIT [true] .yes

		;find a lit object visible to the player's room
		store l02 02
.lp		test_attr l01 LIT [false] .c
		store l02 PLAYER_ID
		call sees(l02, l01) -> (sp)
		je (sp) 00 .c  ; not lit, keep looking
		rtrue
.c		inc l01
		je l01 NUM_OBJECTS_ [false] .lp
	store canSee l01
	rfalse		
.yes	store canSee l01
		rtrue

 

routine look_at_sub
byte 03
word 0,0,0 
		store l01 l00
		get_prop NOUN_1 DESCRIPTION -> (sp)
		print_paddr (sp)
		new_line
		je NOUN_1 PLAYER_ID .x ; don't look inside player
		;now list the contents
		call has_visible_children NOUN_1 -> l02
		je l02 00 .x ; no contents ; no contents, done
		test_attr NOUN_1 CONTAINER .container
		test_attr NOUN_1 SUPPORTER .x
		;list supporter's visible contents
		store l01 @onthe
		print_paddr l01
		print_obj NOUN_1
		store l01 @is
		print_paddr l01
		new_line
		get_child NOUN_1 l01 [false] .x
		call list_siblings l01 -> l01
		rtrue
.container
		test_attr NOUN_1 SUPPORTER [false] .x ;could be neither
		test_attr NOUN_1 OPEN [false] .x
		print_char 'n'
		print_char '1'
		print_num NOUN_1
		new_line
		call look_in_sub NOUN_1 -> l01
.x		rtrue

;l00 is the object whose children to check 
routine has_visible_children
byte 02
word 0,0
	store l01 l00
	get_child l01 -> l01 [false] .x  ;get first child
.lp	
	test_attr l01 SCENERY .c
	rtrue ; not scenery, return true
.c get_sibling l01 -> l01 .lp	
.x	rfalse

routine look_in_sub
byte 3
word 0,0,0
;	print_num l00 
;	new_line
;	print_char 'l'
;	print_char 'i'
;	print_obj NOUN_1
;	new_line
	store l01 NOUN_1
	test_attr l01 SUPPORTER .solid
	test_attr l01 CONTAINER [false] .solid; 
	; must be a container    
	test_attr l01 OPEN .lookin 
	jump .closed
.solid
;	print_char 's'
	store l01 @cantlook
	print_paddr l01
	new_line
	rtrue
.closed
	store l01 @the
	print_paddr l01
	print_obj NOUN_1
	store l01 @isclosed
	print_paddr l01
	new_line
	rtrue
.lookin
	call has_visible_children NOUN_1 -> (sp)
	je (sp) 00 .empty
	get_child NOUN_1 -> l01 [false] .empty
	store l02 @the
	print_paddr l02
	print_obj NOUN_1
	store l02 @contains
	print_paddr l02
	new_line
;	print_char 's'
;	print_char 'i'
;	print_char 'b'
;	new_line
	call list_siblings l01 -> l01
	rtrue
.empty	
	store l01 @the
	print_paddr l01
	print_obj NOUN_1
	store l01 @isempty
	print_paddr l01
	new_line
	rtrue

.check_not_self_or_child		
;a contains object to look in 		
routine look_in_user_fn
byte 2
word 0,0
	store l01 l00
;	print_num l01
;	new_line
	push NOUN_1 ; save NOUN_1
;	print_obj l01
;	new_line
	call look_in_sub -> l01
	store NOUN_1 (sp) ; restore NOUN_1
	rtrue

;Called from generated code
;param is the object to look at	
routine describe_object
byte 2
word 0,0
	store l01 l00
	call look_at_sub l01 -> l01
	rtrue
	