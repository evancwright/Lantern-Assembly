;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;These routines are jumped to by the 
;default actions table
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
routine inventory_sub
byte 4
word 0,0,0,0
    store l01 PLAYER_ID
    call has_visible_children l01 -> l02 
    je l02 00  .noItems
    store l01 @carrying ; You are carrying...
    print_paddr l01
    new_line
    store l01 PLAYER_ID
    get_child l01 -> l02 [false] .lp ; should never branch 
.lp
    call list_siblings l02 -> l01
    rtrue
.noItems
    store l01 @noitems
    print_paddr l01
    new_line
    rtrue

;This routine is used by look_sub and inventory_sub
;l01 is the first sibling
;print the objects across the sibling level
;if it's an open container, list it's contents
;if it's a supporter, list it's contents
routine list_siblings
byte 4
word 0,0,0,0
    store l02 l00
;    print_num l02
.lp
    test_attr l02 SCENERY .c
    print_obj l02 ;print the object
    call print_adjective l02 ->l01
    new_line
    call has_visible_children l02 -> (l03) 
    je l03 00 .c ; skip if no children
    call print_on_the_in_the l02 -> l02 
.n  get_child l02 -> l03 [false] .c
    call list_siblings l03 -> l01    
.c  get_sibling l02 -> l02 .lp
.x  rtrue

 
routine move_player
byte 4
word 0,0,0,0
    store l01 PLAYER_ID
    get_parent (l01) -> l01  ;set current_room variable
    call get_target_room(l01) -> l02
;    print_char 't'
;    print_char 'g'
;    print_char 't'
;    print_num l02
;    new_line
    ;put the player in that room
    insert_obj PLAYER_ID l02
    ;is l01 a door? if no, skip, else move through door
    test_attr l02 DOOR [false] .x
    call get_target_room l02 -> l02 
    insert_obj PLAYER_ID l02
.x  call look_sub -> sp
    ;set the global variable with the player's location
    store g00 l02
    rtrue

routine get_sub
byte 4
word 0,0,0,0
    store l02 PLAYER_ID
    insert_obj NOUN_1 l02
    ;can't set a property that is just the default value
    get_prop NOUN_1 INITIAL_DESCRIPTION -> (sp)
    je (sp) 00 .c
    put_prop NOUN_1 INITIAL_DESCRIPTION 00 ; clear initial description
.c    rtrue

routine enter_sub
byte 4
word 0,0,0,0
    store l01 PLAYER_ID
    insert_obj l01 NOUN_1
    ;set the global variable with the player's location
    store g00 NOUN_1
    call look_sub -> sp
    ret_popped

routine drop_sub
byte 4
word 0,0,0,0
    store l01 PLAYER_ID
    get_parent l01 -> l01
    insert_obj NOUN_1 l01
    clear_attr l01 BEING_WORN
    rtrue
  

routine put_sub
byte 4
word 0,0,0,0
    insert_obj NOUN_1 NOUN_2
    store l02 @done
    print_paddr l02
    new_line
    rtrue


routine open_sub
byte 4
word 0,0,0,0
    set_attr NOUN_1 OPEN
    call has_visible_children NOUN_1 -> (sp)
	je (sp) 00 .empty
    store l02 @openingThe
    print_paddr l02
    print_obj NOUN_1
    store l02 @reveals
    print_paddr l02
    new_line
    get_child NOUN_1 -> l01 [false] .x
	call list_siblings l01 -> l01
	rtrue
.empty
    store l01 @the
    print_paddr l01
    print_obj NOUN_1
	store l01 @isempty
	print_paddr l01
	new_line
.x  rtrue

routine close_sub
byte 4
word 0,0,0,0
    clear_attr NOUN_1 OPEN
    rtrue



routine quit_sub
byte 4
word 0,0,0,0
    rtrue

routine lock_sub
byte 4
word 0,0,0,0
    set_attr NOUN_1 LOCKED
    rtrue

routine unlock_sub
byte 4
word 0,0,0,0
    clear_attr NOUN_1 LOCKED
    rtrue

;assumes checks have passed    
routine wear_sub
byte 4
word 0,0,0,0
    set_attr NOUN_1 BEING_WORN
    get_prop_addr NOUN_1 INITIAL_DESCRIPTION -> l01 ; test if it has an initial desc
    je l01 00 .x
    put_prop NOUN_1 INITIAL_DESCRIPTION 00
.x  rtrue


;if a wearable item's parent isn't the player
;it's worn bit in unset
routine unwear_items()
byte 3
word 0,0,0
    store l01 02 ; loop counter
.lp
    test_attr l01 WEARABLE [false] .c
    get_parent l01 -> l02
    je l02 PLAYER_ID [true] .c
    clear_attr l01 BEING_WORN
.c 
    inc l01
    je l01 NUM_OBJECTS_ [false] .lp    
    rtrue

routine save_sub
byte 4
word 0,0,0,0
    rtrue

routine restore_sub
byte 4
word 0,0,0,0
    rtrue

;returns the pointer to a string
;the number of the string is passed
;in via l00
routine get_string_ptr()
byte 4
word 0,0,0,0
    store l03 l00 ;counter
    store l01 STRINGS ; base pointer
.lp
    loadb l01 00 -> l02 ;get byte of word
    and l02 80 -> l02 ; clear all but top bit (stop bit)
 ;   print_num l02
    je l02 00 .c
    dec l03  ; (hit the end of a string) loop counter--
.c  add l01 02 -> l01 ;next word   
    je l03 00 [false] .lp
    div l01 02 -> l01 ; pack address
    push l01
 ;   print_char 's'
 ;   print_num l01
 ;   new_line
    ret_popped


;PROBLEM - The stop bit on the input isn't set (but it is)
;String 110 has the stop bit set
;1 in dictionary  = 152594a5 = d5413,d-27483 (stop bit) = 0+5+9+5 SECOND BYTE is 1 + 5 + 5 + 5
;1 in the string table =  9525 = 1+5+9+5

;for now compare just the first two words of what was entered
;returns the number of the string in the strings list    
;l01 -table pointer
;l02 -first word of answer
;l03 -second word of answer
;l04 -temp
;l05 -result
;l06 is stop bit (either 00 or 80)
routine lookup_answer_number()
byte 7
word 0,0,0,0,0,0,0
    store l05, 00
    loadw gee 01 -> l01  ; get address of first word
    loadw l01 00 -> l02  ; get first word  (works)
    loadw l01 01 -> l03  ; get second word (works)
    store l01 STRINGS ; base pointer
.outer
    ;does the 1st word match?
    loadw l01 00 -> l04
    je l02 l04 [false] .inner
    ;if there isn't a second word, we have a match
    loadb l01 00 -> l04
    and l04 80 -> l06
    je l06 80 .match ; if stop bit is set, we have a match
    ;does the second word match?
    loadw l01 01 -> l04
    je l03 l04 [false] .inner
    ;found a match
.match
    push l05
    ret_popped
.inner ; run to start of next word
    ;if not at end already, run to the end of the current word, then add 1
    je l06 80 [false] .run_ahead
    ;if at end, just add 1 to table pointer to get to the next string
    inc l01
    jump .outer
.run_ahead
    add l01 02 -> l01 ;next word   
    loadb l01 00 -> l04 ;get byte of word
    and l04 80 -> l04 ; clear all but top bit (stop bit)
    je l04 00 .run_ahead
    add l01 02 -> l01 ; skip to start of next word
    inc l05  ; (hit the end of a string) result++
    je l05 NUM_STRINGS .not_found
    jump .outer
.not_found
    rfalse


;called every turn to set the weight of the inventory
routine set_inv_weight()
byte 3
word 0,0,0
    store invWeight 00 ; clear and recalculate
    store l01 PLAYER_ID
    call add_child_weights PLAYER_ID -> l01
;    print_char 'w'
;    print_num invWeight
;    new_line
    rtrue

;1st param is parent of the child whose add_child_weights
;need to be added up
routine add_child_weights()
byte 3
word 0,0,0
    store l01 L00
    get_child l01 -> l01 [false] .x
.lp
    get_prop l01 WEIGHT -> (sp)
    add invWeight (sp) -> invWeight
    ;recurse through children
    get_child l01 -> l02 [false] .c
    call add_child_weights l02 -> l02
.c  get_sibling l01 -> l01 .lp
.x rtrue

