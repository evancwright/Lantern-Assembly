;code for crawling through a table


routine run_default_sentences
byte 3
word 0,0,0
    store l01 gdd
.lp
    loadb l01 00 -> l02
    je l02 ff .x
    je l02 VERB_ID [false] .c
    inc l01 ; move to address word
    loadw l01 00 -> l02
    div l02 2 -> l02
    call l02 -> (sp)
    rtrue
.c  add l01 03 -> l01 ; move to next entry
    jump .lp
.x   rfalse


;param 1 is the table address
routine run_sentences
byte 8
word 0,0,0,0,0,0,0,0
    store l01 l00 ; table address
    ;try to find an exact match
.lp
    loadb l01 0 -> l03 ;get verb
    je l03 ff .wildcards  ; hit the end
    je l03 VERB_ID [false] .cont
    loadb l01 01 -> l03 ;get noun 1
    je l03 NOUN_1 [false] .cont
    loadb l01 02 -> l03 ;get noun 1
    je l03 PREP_ID [false] .cont
    loadb l01 03 -> l03 ;get noun 1
    je l03 NOUN_2 [false] .cont
    loadw l01 02 -> l03
    div l03 02 -> l03
    call l03 -> (l03)
    rtrue
.cont
    add l01 06 -> l01 ; skip to next entry
    jump .lp
.wildcards
    ;print_char '*'
    ;new_line

    ;if sentence contains 254 as the noun and the actual noun isn't 255
    ;it is considered a match
    store l01 l00 ; reset table address
    store l02 00 ;reset byte index
;    store l03 02 ;reset word index
    ;create 2 variables table n2, table n2
    ;l05, l06
    ;if the sentence has a wildcars in n1 or n2
    ;copy noun 1 or noun 2 into the variables
.lp2
    loadb l01 0 -> l03 ;get verb
    je l03 ff .out  ; hit the end
    je l03 VERB_ID [false] .cont2
    loadb l01 02 -> l03 ;get prep id
    je l03 PREP_ID [false] .cont2
    ;now check nouns
    loadb l01 01 -> l05 ;get sentence noun 1 (l05)
    je l05 fe [false] .n1 ;sentence is fe, replace l05 with noun1
    store l05 noun1 ; yes, copy noun2 into l05
.n1
    loadb l01 03 -> l06  ;get sentence noun 2 (l06)
    je l06 fe [false] .n2 ; noun 2 a wildcard?
    store l06 noun2  ; yes - copy noun 2 into l06
.n2 ;now see if l05 and l06 match noun1 and noun2, if so call the sentence 
    je l05 NOUN_1 [false] .cont2 ; wildcards didn't match
    je l06 NOUN_2 [false] .cont2 ; wildcards didn't match
    ;match found, call the function    
    loadw l01 02 -> l03
    div l03 02 -> l03
    call l03 -> (sp)
    rtrue
.cont2
    add l01 06 -> l01 ; skip to next entry
    jump .lp2
.out
    rfalse