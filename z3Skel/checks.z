	new_line
	rfalse
.yes rtrue

;checks if noun1 is a child of noun2	
;and forbids this
routine check_not_self_or_child
byte 3
word 0,0,0
	store l02 NOUN_1
	store l01 NOUN_2
	call has(l01,l02) -> (sp)
	je (sp) 00 .x
	store l01 @badput
	print_paddr l01 
	new_line
	rfalse 
.x	rtrue

;checks if NOUN1 is a child of the NOUN2	
;returns 1 or 0 in 'a'
;1 means the containership is invalid

routine check_nested_containership
byte 2
word 0,0
	; check self
	je l01 l02 .no
	; check contains
	store l01 NOUN_1
	store l02 NOUN_2
	call has(l02,l01) -> (sp)
	je (sp) #0 .no
	rtrue
.no rfalse

;l00 - holder
;l01 - object
routine has()
byte 4
word 0,0,0,0
	jin l01 l00 .y  ;JIN JUMP OFFSET MAY NOT WORK
.lp
	get_parent l01 -> l01 ; get parent of object
;	print_num l01
;	new_line
	je l01 00 .n ;hit top of tree
	je l01 l00 .y ;reached the room
	jump .lp
.y rtrue
.n rfalse


;l00 - seer
;l01 - object
routine sees()
byte 4
word 0,0,0,0
	je l01 l00 .y ; you can see yourself
	jin l01 l00 .y  ;JIN JUMP OFFSET MAY NOT WORK
	get_parent l00 -> l00 ; get room the seer is in
.lp
	get_parent l01 -> l01 ; get parent of object
;	print_num l01
;	new_line
	je l01 00 .n ;hit top of tree
	je l01 l00 .y ;reached the room
	;if parent isn't a container, object is hidden
	test_attr l01 CONTAINER [false] .cs
	; parent is a container, check if it's OPEN
	test_attr l01 OPEN [false] .n 
	jump .lp
.cs	test_attr l01 SUPPORTER [false] .n ;if not supporter (object is hidden)
	jump .lp
.y rtrue
.n rfalse


routine check_prep_supplied
byte 2
word 0,0
	je PREP_ID #FF [false] .x
	store l01 @missingprep
	print_paddr l01
	new_line
	rfalse
.x	rtrue


routine check_light
byte 2
word 0,0
	call player_has_light->(sp) ; in look.z
	je (sp) 01 .x
	store l01 @pitchdark
	print_paddr l01
	new_line
	rfalse
.x	rtrue
	

 
;container or supporter
routine check_iobj_container
byte 2
word 0,0
	test_attr NOUN_2 CONTAINER .y
	test_attr NOUN_2 SUPPORTER .y
	store l01 @notcontainer
	print_paddr l01
	new_line
	rfalse
.y	rtrue


routine check_dobj_wearable
byte 2
word 0,0
		print_obj NOUN_1
		new_line
		test_attr NOUN_1 WEARABLE [false] .nw
		test_attr NOUN_1 BEING_WORN [true] .bw
		rtrue
.nw		store l01 @notwearable
		print_paddr l01
		new_line
		rfalse
.bw		store l01 @alreadyworn
		print_paddr l01		
		new_line
		rfalse



