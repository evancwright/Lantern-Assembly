;this is the main routine
#define TEXT_BUF_SIZE 40
#define NUM_INPUT_WORDS 20

include defs.z
include verb_defs.z
include global_defs.z
include header.z
include arrays.z
include default_props.z
include objects.z

;global variables - first two are the buffers
.globals

#define NOTO_TABLE gdc
#define DFLT_SENTENCE_TABLE gdd
#define INDENT_AMOUNT gde
#define PREACTIONS_TABLE ge0
#define ACTIONS_TABLE ge1
#define POSTACTIONS_TABLE ge2
#define PREP_ID Ge3
#define NOUN_1 Ge4
#define noun1 Ge4
#define dobj Ge4
#define NOUN_2 Ge5
#define noun2 Ge5
#define iobj Ge5
#define COMPOUND_VERB_TABLE GE6
#define VERB_PREP_ID GE7
#define VERB_ID GE8
#define PREP_INDEX GE9
#define TWO_WORD_VERB GEA
#define WRD_ID_BUFFER gEB
#define REAL_WORDS gEC ;number of input words minus articles
#define STRINGS gdb

;number of globals needs to add up to 240
defw START_LOC	;player location G00
defw 00   	; score?
defw 00		;moves	
resw 216
defw .static_strings ;gdb
defw .nogo_string_table ;gdc
defw .default_sentence_table  ; gdd
defw 0 ; indent amount gde
defw .check_table ; gdF 
defw .preactions_table ;ge0
defw .actions_table ;ge1
defw .postactions_table ;ge2
defw 00 ;PREP_ID ge3
defw FF ;NOUN_1 ge4
defw FF ;NOUN_2 ge5 
defw  .compound_verb_table ; GE6  10 vars
defw 0		;ge7 VERB_PREP_ID
defw 0		; ge8 VERB_ID
defw 0		;ge9 prep index
defw 0		;gea T/f 2 word verb
defw .word_storage ; geb
defw 0 ;gec	number of words
defw .text_buffer  ; ged
defw .parse_buffer ; gee
defw 0 ; num objects ;gef
;the actual buffers
.text_buffer
defb 18  ;max letters
resb 32  ;32 characters of input
.parse_buffer
defb 0A ; ten words
resw 42
defb 0; packing

.word_storage
resw 10


.static_mem
.synonyms
.verbs
include zverbs.z 

.verb_map
include verb_map.z

.dictionary
include dictionary.z

;we need the verb check table
include check_table.z
include before_table_z3.z
include instead_table_z3.z
include after_table_z3.z

include default_sentence_table.z
include nogo_table.z

.hi_mem
.initial_pc
.routines

	call actual_main (sp)

routine actual_main()
defb 2
defw 0,0
	store NUM_OBJECTS NUM_OBJECTS_
	store l01 @welcome
	print_paddr l01; print welcome,author,version
	new_line
	store l01 @author
	print_paddr l01
	new_line
	store L01 @version
	print_paddr L01
	new_line	
;	call game_start_sub -> (sp)
	new_line
	call look_sub -> (sp)
.main_loop	

	;clear the buffers
	print_char 3e ; > (prompt)
	read  gED gEE ;read into text and parse buffers
	;The number of words is written in byte 1 and one 4-byte block is written for each word
	;from byte 2 onwards (except that it should stop before going beyond the maximum number 
	;of words specified). Each block consists of the byte address of the word in the dictionary, 
	;if it is in the dictionary, or 0 if it isn’t; followed by a byte giving the number of letters 
	;in the word; and finally a byte giving the position 
	;in the text-buffer of the first letter of the word.
	;[ dict adddr or 0 (word), num letters, index byte ] 

	call copy_words -> (sp) ;get's prep id
	je (sp) 00 .main_loop
;	print_char 'r' ;r
;	print_char 'w ;w
;	print_num REAL_WORDS
;	new_line
	call find_verb_id -> (sp)
	je (sp) 00 .main_loop
	call score_noun1 -> (sp)
	call score_noun2 -> (sp)
;	call dump_sentence -> (l01)
	;now call the verb checks
	call run_checks() -> (sp)
	je (sp) 00 .main_loop
	call run_sentences(PREACTIONS_TABLE) -> l01
	call run_sentences(ACTIONS_TABLE) -> l01
	je l01 01 .no_def ; was it handled?
	call run_default_sentences() -> l01
.no_def
	call run_sentences(POSTACTIONS_TABLE) -> l01

	;run events
	call do_events() -> l01
	call set_inv_weight() -> l01

	;handle light
	store couldSee canSee
	call player_has_light() -> (sp)
	je (sp) 00 .noLight
	store turnsWithoutLight 00
	jump .loop
.noLight
	inc turnsWithoutLight	
	
.loop
;	print_char 'd'
;	print_num turnsWithoutLight
;	new_line
	jump .main_loop
	 
;param 1 is the index
;param 2 is the length
routine print_word
defb 3
defw 0,0,0
.top
 	loadb           Ged,L00 -> -(SP) ; 4 bytes
 	print_char      (SP)+ ;3
	dec             L01 ;2  
	inc l00
 	je l01 00 [false] .top ;3  17 bytes  (15 bytes?)
	rtrue



include parser.z
include events.z
include checks.z
include default_actions.z
include sentences.z
include look.z
include doevents.z

.static_strings
include strings.z
include nogostrings.z
include defaultstrings.z

.file_size
